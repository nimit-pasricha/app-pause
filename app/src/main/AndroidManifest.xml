<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The app's whole job is to notice and list other apps, so it needs to
         see them. Justified for a sideloaded, on-device-only tool. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Granting "Display over other apps" lets the pause reliably appear on
         top of the watched app (and exempts our activity launch from
         background-launch limits). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Beat">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The pause screen. Launched over the watched app by the accessibility
             service; kept in its own task, out of recents, and not relaunched on
             top of itself. -->
        <activity
            android:name=".ui.PauseActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.nimitpasricha.pause.pause"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Beat" />

        <!-- Detects which app comes to the foreground and launches the pause. -->
        <service
            android:name=".service.PauseAccessibilityService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
